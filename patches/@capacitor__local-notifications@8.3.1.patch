+package com.capacitorjs.plugins.localnotifications;
+
+/** App-owned routing identifiers, not a prefix match or a change to system volume. */
+public final class TiaAlarmChannels {
+    private TiaAlarmChannels() { }
+
+    public static boolean usesLegacyAlarmStream(int sdkInt, String channelId) {
+        return sdkInt >= 24 && sdkInt < 26 && (
+            "tia-alarm-v1-dawn".equals(channelId)
+                || "tia-alarm-v1-chime".equals(channelId)
+                || "tia-alarm-v1-pulse".equals(channelId)
+        );
+    }
+}
