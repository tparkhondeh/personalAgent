# Local database file. Never commit the real database.
DATABASE_URL="file:./data/hamrah.db"

# Generate long random values for production.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# LLM provider (OpenAI-compatible providers can be added later).
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
# Keep false until the account owner approves API usage and sets a provider budget.
OPENAI_COST_APPROVED="false"
# Shared text/audio count for all users per UTC day; NOT a dollar budget.
# Zero or an invalid explicit value disables external requests. Maximum 100.
OPENAI_DAILY_REQUEST_LIMIT="20"
# Paid transcription is separate from GPT text and requires audio permissions/consent.
OPENAI_VOICE_ENABLED="false"
OPENAI_TRANSCRIBE_MODEL=""
# Optional Windows-hosted encrypted credential instead of a plaintext key.
# Keep file/executable paths private and server-only; DPAPI is CurrentUser-bound.
# OPENAI_API_KEY_DPAPI_FILE="<absolute-private-file.dpapi>"
# OPENAI_DPAPI_POWERSHELL="<trusted-absolute-powershell-executable>"
# Optional one-off synthetic QA scope; leave ALL THREE absent for normal operation.
# Do not enable with personal data. Ledger must be outside this web workspace,
# pre-created privately and retained across restarts (never reset the allowance).
# Key lifetime is independent of this short test window. See docs/GPT_SYNTHETIC_TEST_GATE_2026-09-15.md.
# OPENAI_TEST_USER_ID="<verified-synthetic-account-id>"
# OPENAI_TEST_LEDGER_DIR="<absolute-private-directory>"
# OPENAI_TEST_EXPIRES_AT="<approved-test-window-end-ISO8601>"
# End QA by disabling OPENAI_COST_APPROVED/removing the runtime key, not merely
# removing these guards. Ordinary-use cost/personal-data consent is separate.

# Paid outbound calls stay simulated unless all three safeguards are configured.
OUTBOUND_CALLS_MODE="mock"
KAVENEGAR_API_KEY=""
OUTBOUND_CALL_VERIFIED_NUMBERS=""

# Web Push notification keys.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Protects both internal scheduler endpoints: reminders and escalations.
CRON_SECRET="replace-with-another-long-random-secret"

# Android development only. Release builds must use an approved HTTPS origin.
CAPACITOR_SERVER_URL=""

# Optional private loopback ASR, never exposed to browser/APK. Default remains on-device.
ASR_SELF_HOSTED_ENABLED="false"
ASR_INTERNAL_TOKEN=""

# Optional account recovery: enable ONLY after approved email delivery and TLS QA.
# These values stay server-side. No emails are sent with the default settings.
ACCOUNT_RECOVERY_EMAIL_APPROVED="false"
RECOVERY_SMTP_HOST=""
RECOVERY_SMTP_PORT="587"
RECOVERY_SMTP_USER=""
RECOVERY_SMTP_PASSWORD=""
RECOVERY_MAIL_FROM=""
RECOVERY_DAILY_EMAIL_LIMIT="0"
# Private backup CLI only: approved passphrase FILE outside repo; never the phrase itself.
TIA_BACKUP_PASSPHRASE_FILE=""
