# Local database file. Never commit the real database.
DATABASE_URL="file:./data/hamrah.db"

# Generate long random values for production.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# LLM provider (OpenAI-compatible providers can be added later).
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
# Keep false until the account owner approves API usage and sets a provider budget.
OPENAI_COST_APPROVED="false"
# Shared text/audio count for all users per UTC day; NOT a dollar budget.
# Zero or an invalid explicit value disables external requests. Maximum 100.
OPENAI_DAILY_REQUEST_LIMIT="20"
OPENAI_TRANSCRIBE_MODEL="gpt-transcribe"

# Paid outbound calls stay simulated unless all three safeguards are configured.
OUTBOUND_CALLS_MODE="mock"
KAVENEGAR_API_KEY=""
OUTBOUND_CALL_VERIFIED_NUMBERS=""

# Web Push notification keys.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Protects both internal scheduler endpoints: reminders and escalations.
CRON_SECRET="replace-with-another-long-random-secret"

# Android development only. Release builds must use an approved HTTPS origin.
CAPACITOR_SERVER_URL=""

# Optional private loopback ASR, never exposed to browser/APK. Default remains on-device.
ASR_SELF_HOSTED_ENABLED="false"
ASR_INTERNAL_TOKEN=""
