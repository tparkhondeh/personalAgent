# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnpm-store
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/backups/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
/prisma/data/
/src/generated/prisma/
*.db
*.db-journal

# Android build outputs and private signing material
/android/.gradle/
/android/.idea/
/android/app/build/
/android/build/
*.jks
*.keystore
keystore.properties
local.properties

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
